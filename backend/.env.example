DATABASE_URL=postgresql://banviro:banviro@localhost:5432/banviro
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# AI layer — Ollama nativ recomandat pe Mac (brew install ollama && ollama serve)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_PREDICT=200
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=banviro_transactions
QDRANT_VECTOR_SIZE=768
AI_ENABLED=true
# MCP server (run_mcp.py) — JWT from POST /api/v1/auth/login
# BANVIRO_ACCESS_TOKEN=
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=banviro
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_COLLECTOR_PROTOCOL=grpc
